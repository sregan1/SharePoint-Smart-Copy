<Window xmlns:loc="clr-namespace:SharePointSmartCopy.Localization" x:Class="SharePointSmartCopy.Dialogs.TeamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SharePointSmartCopy.Converters"
        xmlns:models="clr-namespace:SharePointSmartCopy.Models"
        Title="{loc:Loc Teams_Title}"
        Width="900" Height="700"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        ResizeMode="CanResize">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InvertBoolConverter x:Key="InvBool"/>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
        <conv:EqualToVisibilityConverter x:Key="EqToVis"/>
        <conv:MultiEqualToBoolConverter x:Key="MultiEqual"/>
        <conv:MultiGreaterThanToBoolConverter x:Key="MultiGreater"/>

        <!-- The same step indicator as the Forms tool and the main window. -->
        <x:Array x:Key="TeamsSteps" Type="models:StepInfo">
            <models:StepInfo Index="0" Display="1" Label="{loc:Loc Teams_StepConnect}"/>
            <models:StepInfo Index="1" Display="2" Label="{loc:Loc Teams_StepChoose}"/>
            <models:StepInfo Index="2" Display="3" Label="{loc:Loc Teams_StepOptions}"/>
            <models:StepInfo Index="3" Display="4" Label="{loc:Loc Teams_StepReview}"/>
            <models:StepInfo Index="4" Display="5" Label="{loc:Loc Teams_StepCopy}"/>
            <models:StepInfo Index="5" Display="✓" Label="{loc:Loc Teams_StepResults}" IsFinal="True"/>
        </x:Array>

        <Style x:Key="StepBubble" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiGreater}">
                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiEqual}">
                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource MultiEqual}">
                                    <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="Index"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding IsFinal}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepBubbleText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Display}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiGreater}">
                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Text" Value="✓"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiEqual}">
                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- step indicator -->
            <RowDefinition Height="*"/>      <!-- step content -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Teams_Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="{Binding StepText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
            <Border Style="{StaticResource InfoBanner}" Padding="12,8" Margin="0,8,0,0"
                    Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=1}">
                <TextBlock TextWrapping="Wrap" FontSize="12" Text="{loc:Loc Teams_Intro}"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,1,0,1" Padding="20,10">
            <ItemsControl ItemsSource="{StaticResource TeamsSteps}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:StepInfo}">
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Label}">
                            <Border Height="2" Width="40" Background="{DynamicResource BorderLightBrush}"
                                    VerticalAlignment="Top" Margin="4,13,4,0"
                                    Visibility="{Binding Index, Converter={StaticResource IntToVis}}"/>
                            <StackPanel>
                                <Border Style="{StaticResource StepBubble}">
                                    <TextBlock Style="{StaticResource StepBubbleText}"/>
                                </Border>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource StepText}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ══ Step content ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="24,16">

            <!-- Step 1: connect (sign in to the source and, between two tenants, the target) -->
            <ScrollViewer Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=0}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="ConnectIntro" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Border x:Name="SourceCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SourceTitle" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="SourceStatus" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="SourceDetail" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SourceSignInButton" Style="{StaticResource PrimaryBtn}" Click="SourceSignIn_Click"/>
                                <Button x:Name="SourceCancelButton" Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Ui_Cancel}"
                                        Click="SourceCancel_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                            <CheckBox x:Name="PersonalCheck" Content="{loc:Loc Teams_Personal_Option}" Margin="0,10,0,0" ToolTipService.ShowOnDisabled="True"
                                      Checked="PersonalCheck_Changed" Unchecked="PersonalCheck_Changed"/>
                            <TextBlock x:Name="AdminNote" TextWrapping="Wrap" Margin="22,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TargetCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Teams_Connect_Target}" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="TargetStatus" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TargetDetail" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="TargetSignInButton" Style="{StaticResource PrimaryBtn}" Click="TargetSignIn_Click"/>
                                <Button x:Name="TargetCancelButton" Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Ui_Cancel}"
                                        Click="TargetCancel_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Step 2: choose a team or chat -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=1}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="LoadButton" Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Teams_Load}" Click="Load_Click"/>
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Teams_SelectAll}" Click="SelectAll_Click" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Teams_ClearSelection}" Click="ClearSelection_Click" Margin="8,0,0,0"/>
                    <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Teams_ChooseHint}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel x:Name="AdminPanel" Grid.Row="1" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc Teams_Admin_FindLabel}" VerticalAlignment="Center"/>
                        <TextBox x:Name="PersonBox" Width="240" Margin="8,0,0,0" KeyDown="PersonBox_KeyDown"/>
                        <Button x:Name="FindPersonButton" Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Teams_Admin_Find}" Click="FindPerson_Click" Margin="8,0,0,0"/>
                        <Button x:Name="AddChatsButton" Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Teams_Admin_AddChats}" Click="AddChats_Click" Margin="8,0,0,0" IsEnabled="False"/>
                    </StackPanel>
                    <ListBox x:Name="PersonResults" MaxHeight="96" Margin="0,6,0,0" Visibility="Collapsed" SelectionMode="Extended" DisplayMemberPath="Label"
                             SelectionChanged="PersonResults_SelectionChanged"/>
                    <TextBlock x:Name="PeopleChosenText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <TreeView x:Name="Tree" Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource BorderLightBrush}"/>
            </Grid>

            <!-- Step 3: options -->
            <ScrollViewer Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=2}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="TargetText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel x:Name="TeamOptions">
                                <TextBlock Text="{loc:Loc Teams_NewName}" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="NewNameBox" MaxWidth="460" HorizontalAlignment="Left" Margin="0,6,0,0" TextChanged="NewNameBox_TextChanged"/>
                                <TextBlock Text="{loc:Loc Teams_NewNameHint}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{loc:Loc Teams_WhatToCopy}" Style="{StaticResource SectionHeader}" Margin="0,16,0,0"/>
                                <CheckBox x:Name="OptSettings" Content="{loc:Loc Teams_OptSettings}" IsChecked="True" Margin="0,6,0,0"/>
                                <CheckBox x:Name="OptMembers" Content="{loc:Loc Teams_OptMembers}" IsChecked="True" Margin="0,6,0,0"/>
                                <CheckBox x:Name="OptFiles" Content="{loc:Loc Teams_OptFiles}" IsChecked="True" Margin="0,6,0,0"/>
                                <CheckBox x:Name="OptMessages" Content="{loc:Loc Teams_OptMessages}" ToolTipService.ShowOnDisabled="True" Margin="0,6,0,0"/>
                                <TextBlock x:Name="MessagesNote" TextWrapping="Wrap" Margin="22,2,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="ChatOptionsText" TextWrapping="Wrap" Text="{loc:Loc Teams_ChatOptionsInfo}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Step 4: review -->
            <ScrollViewer Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=3}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <TextBlock x:Name="ReviewText" TextWrapping="Wrap"/>
                    </Border>
                    <DataGrid x:Name="ReviewNames" Margin="0,12,0,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="260" SelectionUnit="Cell"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}" CellEditEnding="ReviewNames_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Teams_Review_ColSource}" Binding="{Binding SourceName}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Teams_Review_ColNewName}" Binding="{Binding NewName, Mode=TwoWay}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Teams_Review_ColChannels}" Binding="{Binding ChannelsText}" IsReadOnly="True" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="PeopleCard" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="PeopleText" TextWrapping="Wrap"/>
                            <Button x:Name="MapPeopleButton" Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Teams_MapPeople}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="MapPeople_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Step 5: copying -->
            <TextBox x:Name="LogBox" Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=4}"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>

            <!-- Step 6: results, like the Files report: outcome banner, number tiles, a status line per part -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=5}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="ResultBanner" Grid.Row="0" Style="{StaticResource InfoBanner}" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ResultHeadline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ResultSubline" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="OpenTeamButton" Grid.Column="1" Style="{StaticResource PrimaryBtn}" Content="{loc:Loc Teams_Result_Open}"
                                Click="OpenTeam_Click" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <ItemsControl x:Name="ResultTiles" Grid.Row="1" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SummaryCard}" Background="{Binding Back}" BorderBrush="{Binding Border}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" Foreground="{Binding Fore}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{Binding Fore}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,8">
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Teams_Result_CopyReport}" Click="CopyReport_Click"/>
                </StackPanel>

                <DataGrid x:Name="ResultRows" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                          Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Teams_Res_ColPart}" Binding="{Binding Area}" Width="230"/>
                        <DataGridTextColumn Header="{loc:Loc Teams_Res_ColDetails}" Binding="{Binding Message}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="ToolTip" Value="{Binding Message}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ══ Footer ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
          <StackPanel>
            <!-- Why Next is disabled: its own full-width, selectable line above the buttons, so a long permission list can be copied and does not stretch the button row. -->
            <TextBox Style="{StaticResource SelectableText}" Text="{Binding BlockReason, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                     Margin="0,0,0,10" Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding HasBlockReason, Converter={StaticResource BoolToVis}}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,12,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding StatusText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" MaxWidth="460"
                             Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Ui_Back}" Click="Back_Click" Margin="0,0,8,0"
                            Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="{Binding NextButtonText}" Click="Next_Click" Margin="0,0,8,0"
                            Visibility="{Binding ShowNext, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanNext}"/>
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Ui_Cancel}" Click="CancelCopy_Click" Margin="0,0,8,0"
                            Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="{loc:Loc Teams_CopyAnother}" Click="CopyAnother_Click" Margin="0,0,8,0"
                            Visibility="{Binding ShowCopyAnother, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Ui_Close}" IsCancel="True"/>
                </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
    </Grid>
</Window>
