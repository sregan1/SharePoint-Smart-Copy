<Window xmlns:loc="clr-namespace:SharePointSmartCopy.Localization" x:Class="SharePointSmartCopy.Dialogs.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc Ui_CopyHistory}"
        Width="980" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="20" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="pack://application:,,,/Resources/logo.png"
                   Height="70" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Grid.Column="2" Text="{loc:Loc Ui_CopyHistory}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Main area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Report list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Ui_PreviousRuns}" FontWeight="SemiBold"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>

                <StackPanel x:Name="ReportListLoading" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
                    <ProgressBar IsIndeterminate="True" Width="60" Height="4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Loc Ui_Loading}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>

                <ListBox Grid.Row="2" x:Name="ReportList" Visibility="Collapsed"
                         BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}"
                         SelectionChanged="ReportList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayDate}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SourceUrl}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="→ "/>
                                    <Run Text="{Binding TargetUrl}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Vertical divider -->
            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderLightBrush}" HorizontalAlignment="Center"/>

            <!-- Detail panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="DetailHeader"
                           Text="{loc:Loc Ui_SelectARunToView}"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- Summary cards for selected report -->
                <StackPanel Grid.Row="2" x:Name="SummaryCards"
                            Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource SummaryCard}" Padding="16,8" Margin="0,0,8,0" MinWidth="90"
                            Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBrush}">
                        <StackPanel>
                            <TextBlock x:Name="SuccessCard" Text="0" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Ui_Succeeded}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}" Padding="16,8" Margin="0,0,8,0" MinWidth="90"
                            Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}">
                        <StackPanel>
                            <TextBlock x:Name="FailedCard" Text="0" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Ui_Failed2}" Foreground="{DynamicResource DangerBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}" Padding="16,8" Margin="0" MinWidth="90"
                            Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}">
                        <StackPanel>
                            <TextBlock x:Name="SkippedCard" Text="0" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Ui_Skipped2}" Foreground="{DynamicResource WarningTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Detail DataGrid -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                  <Grid>
                    <DataGrid x:Name="DetailGrid"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="{DynamicResource SurfaceBrush}"
                              AlternatingRowBackground="{DynamicResource SurfaceAltBrush}" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Ui_FileName}"   Binding="{Binding FileName}"   Width="200"/>
                            <DataGridTemplateColumn Header="{loc:Loc Ui_Status}" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusDisplay}" Margin="4,2"
                                                   Foreground="{Binding StatusColor}"
                                                   FontWeight="SemiBold" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Ui_SourcePath}" Binding="{Binding SourcePath}" Width="220"/>
                            <DataGridTextColumn Header="{loc:Loc Ui_TargetPath}" Binding="{Binding TargetPath}" Width="220"/>
                            <DataGridTextColumn Header="{loc:Loc Ui_Versions2}"    Binding="{Binding VersionsCopied}" Width="65"/>
                            <DataGridTextColumn Header="{loc:Loc Ui_Error}"       Binding="{Binding ErrorMessage}"  Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource GhostText}"
                               Text="{loc:Loc Ui_SelectARunOnThe}"/>
                  </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="DeleteButton" Content="{loc:Loc Ui_DeleteRun}"
                        Style="{StaticResource DangerBtn}"
                        IsEnabled="False" Click="DeleteButton_Click"/>

                <!-- Cancel is alone in this column now — the status message moved to its own
                     full-width row below, so this button is never at the mercy of unbounded status
                     text length (that was the earlier bug: sharing a column with it either pushed
                     Cancel out of view, or truncating the text to protect Cancel cut the message off
                     instead — neither is acceptable, so they no longer share space at all). -->
                <Button Grid.Column="1" x:Name="VerifyCancelButton" Content="{loc:Loc Ui_Cancel}" Style="{StaticResource DangerBtn}"
                        Visibility="Collapsed" Margin="16,0,0,0" HorizontalAlignment="Left"
                        Click="VerifyCancelButton_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="DeepVerifyCheckBox" VerticalAlignment="Center" FontSize="12"
                              Margin="0,0,14,0" Checked="DeepVerifyCheckBox_Changed" Unchecked="DeepVerifyCheckBox_Changed"
                              AutomationProperties.Name="{loc:Loc Ui2_AutoDeepVerifyOffice}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Ui_DeepVerifyOfficeFiles}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource ToolTipIcon}">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="280">
                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                   Text="{loc:Loc Ui_DownloadsBothCopiesOfEach}"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </CheckBox>
                    <Button x:Name="ExportButton" Content="{loc:Loc Ui_ExportCsv}"
                            Style="{StaticResource SecondaryBtn}"
                            IsEnabled="False" Margin="0,0,10,0" Click="ExportButton_Click"/>
                    <Button x:Name="VerifyButton" Content="{loc:Loc Ui_VerifyWithExcelReport}"
                            Style="{StaticResource SecondaryBtn}"
                            IsEnabled="False" Margin="0,0,10,0" Click="VerifyButton_Click"/>
                    <Button Content="{loc:Loc Ui_Close}" Style="{StaticResource SecondaryBtn}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Full-width row, own line below the buttons — wraps rather than truncates, so a long
                 status message (file counts, deep-verify progress, throttle notices) is always fully
                 visible instead of being clipped by a narrow shared column. -->
            <TextBlock Grid.Row="1" x:Name="VerifyStatus" FontSize="12" Visibility="Collapsed"
                       Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Grid>
    </Grid>
</Window>
