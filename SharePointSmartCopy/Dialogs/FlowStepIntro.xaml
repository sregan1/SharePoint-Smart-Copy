<UserControl x:Class="SharePointSmartCopy.Dialogs.FlowStepIntro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SharePointSmartCopy.Converters"
             xmlns:loc="clr-namespace:SharePointSmartCopy.Localization"
             x:Name="Root">
    <!-- The top of every Flows step: the step's title, one line saying what happens, and a "What happens here" link that
         opens the longer explanation (why the step exists, and that nothing is changed in either tenant). The open/closed
         state is the dialog's HelpOpen flag, which closes again whenever the step changes. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource SectionHeader}"/>
        <TextBlock Text="{Binding What, ElementName=Root}" Style="{StaticResource SubHeader}"/>
        <ToggleButton Style="{StaticResource HelpToggle}" Margin="0,6,0,0" HorizontalAlignment="Left"
                      IsChecked="{Binding DataContext.HelpOpen, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                      Content="{loc:Loc Flows_WhatHappensHere}"/>
        <Border Style="{StaticResource InfoBanner}" Margin="0,6,0,0" Padding="12,8"
                Visibility="{Binding DataContext.HelpOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding Why, ElementName=Root}"/>
        </Border>
    </StackPanel>
</UserControl>
