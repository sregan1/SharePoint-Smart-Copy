<Window xmlns:loc="clr-namespace:SharePointSmartCopy.Localization" x:Class="SharePointSmartCopy.Dialogs.FlowsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SharePointSmartCopy.Converters"
        xmlns:models="clr-namespace:SharePointSmartCopy.Models"
        Title="{loc:Loc Flows_Title}"
        Width="1040" Height="800"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        ResizeMode="CanResize">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InvertBoolConverter x:Key="InvBool"/>
        <conv:IntToVisibilityConverter x:Key="IntToVis"/>
        <conv:EqualToVisibilityConverter x:Key="EqToVis"/>
        <conv:MultiEqualToBoolConverter x:Key="MultiEqual"/>
        <conv:MultiGreaterThanToBoolConverter x:Key="MultiGreater"/>

        <!-- Same four-step indicator as the main window: gray = upcoming, check = done, accent = current,
             green = the final (Results) step. DataContext of a step is a StepInfo; CurrentStep comes from this
             window's view model. -->
        <x:Array x:Key="FlowsSteps" Type="models:StepInfo">
            <models:StepInfo Index="0" Display="1" Label="{loc:Loc Flows_StepPackages}"/>
            <models:StepInfo Index="1" Display="2" Label="{loc:Loc Flows_StepSites}"/>
            <models:StepInfo Index="2" Display="3" Label="{loc:Loc Flows_StepMatch}"/>
            <models:StepInfo Index="3" Display="4" Label="{loc:Loc Flows_StepFormsEmail}"/>
            <models:StepInfo Index="4" Display="5" Label="{loc:Loc Flows_StepWrite}"/>
            <models:StepInfo Index="5" Display="✓" Label="{loc:Loc Flows_StepReport}" IsFinal="True"/>
        </x:Array>

        <Style x:Key="StepBubble" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiGreater}">
                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiEqual}">
                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True">
                            <Condition.Binding>
                                <MultiBinding Converter="{StaticResource MultiEqual}">
                                    <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="Index"/>
                                </MultiBinding>
                            </Condition.Binding>
                        </Condition>
                        <Condition Binding="{Binding IsFinal}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepBubbleText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Display}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiGreater}">
                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Text" Value="✓"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiEqual}">
                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            <Binding Path="Index"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Result banner: success (green), needs attention (amber), failed (red), cancelled (blue) -->
        <Style x:Key="OutcomeBanner" TargetType="Border" BasedOn="{StaticResource InfoBanner}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Outcome}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Partial">
                    <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- step indicator -->
            <RowDefinition Height="*"/>      <!-- step content -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,12">
            <TextBlock Text="{loc:Loc Flows_Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="{loc:Loc Flows_Subtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,1,0,1" Padding="20,10">
            <ItemsControl ItemsSource="{StaticResource FlowsSteps}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:StepInfo}">
                        <StackPanel Orientation="Horizontal">
                            <Border Height="2" Width="44" Background="{DynamicResource BorderLightBrush}"
                                    VerticalAlignment="Top" Margin="4,13,4,0"
                                    Visibility="{Binding Index, Converter={StaticResource IntToVis}}"/>
                            <StackPanel>
                                <Border Style="{StaticResource StepBubble}">
                                    <TextBlock Style="{StaticResource StepBubbleText}"/>
                                </Border>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource StepText}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ══ Step content ═════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="24,16">

            <!-- ── Step 1: packages ─────────────────────────────────────────── -->
            <ScrollViewer Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=0}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc Flows_PackagesHeader}" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Flows_Step1Hint}"/>

                    <Border Style="{StaticResource InfoBanner}" Margin="0,12,0,0" Padding="12,8">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{loc:Loc Flows_HowToExport}"/>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="PackagesBox" IsReadOnly="True" Style="{StaticResource BaseTextBox}"
                                 Text="{Binding PackagesText, Mode=OneWay}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource PrimaryBtn}" Content="{loc:Loc Flows_AddZips}" Click="AddZips_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                            <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Flows_AddFolder}" Click="AddFolder_Click" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                            <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Flows_ClearPackages}" Click="ClearPackages_Click" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                            <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Flows_LoadMapping}" Click="LoadMapping_Click" Margin="8,0,0,0"
                                    ToolTip="{loc:Loc Flows_LoadMappingTip}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding ScanSummaryText}"/>

                    <StackPanel Visibility="{Binding HasScan, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                        <TextBlock Text="{loc:Loc Flows_ResourcesHeader}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Flows_ResourcesHint}"/>
                        <DataGrid x:Name="ResourcesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="230" Margin="0,6,0,0"
                                  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Flows_ColService}" Binding="{Binding Service}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Loc Flows_ColFlows}" Binding="{Binding Flows}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Loc Flows_ColSteps}" Binding="{Binding Operations}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Loc Flows_ColFound}" Binding="{Binding Detail}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc Flows_ColHandling}" Binding="{Binding HandlingText}" Width="250"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Step 2: sites ────────────────────────────────────────────── -->
            <ScrollViewer Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=1}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc Flows_SitesHeader}" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Flows_Step2Hint}"/>

                    <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0" Padding="12,8"
                            Visibility="{Binding NoSites, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{loc:Loc Flows_NoSitesFound}"/>
                    </Border>

                    <DataGrid x:Name="SitesGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MaxHeight="260" Margin="0,12,0,0"
                              Visibility="{Binding HasSites, Converter={StaticResource BoolToVis}}"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColSourceSite}" Binding="{Binding Source}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColTargetSite}" Binding="{Binding Target, UpdateSourceTrigger=LostFocus}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasSites, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc Flows_TargetHost}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="HostBox" Width="300" Style="{StaticResource WatermarkTextBox}" Tag="https://contoso.sharepoint.com"/>
                        <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Flows_FillHost}" Click="FillHost_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SubHeader}" Margin="0,12,0,0" Text="{loc:Loc Flows_SitesNext}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Step 3: lists and columns ────────────────────────────────── -->
            <ScrollViewer Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=2}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Flows_MatchHeader}" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Flows_Step3Hint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" VerticalAlignment="Top"
                                Content="{loc:Loc Flows_MatchAgain}" Click="MatchAgain_Click"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                    </Grid>

                    <Border Style="{StaticResource InfoBanner}" Margin="0,10,0,0" Padding="12,8"
                            Visibility="{Binding HasMatchSummary, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding MatchSummaryText}"/>
                    </Border>

                    <Border Style="{StaticResource WarningBanner}" Margin="0,10,0,0" Padding="12,8"
                            Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding NotesText}"/>
                    </Border>

                    <TextBlock Text="{loc:Loc Flows_ListsHeader}" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <DataGrid x:Name="ListsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="220" Margin="0,6,0,0"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColList}" Binding="{Binding Title}" IsReadOnly="True" Width="170"/>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColSourceListId}" Binding="{Binding SourceListId}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColTargetListId}" Binding="{Binding TargetListId, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Forms_ColResult}" Binding="{Binding StatusText}" IsReadOnly="True" Width="190"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource SubHeader}" Margin="0,4,0,0" Text="{loc:Loc Flows_ListsEditHint}"/>

                    <TextBlock Text="{loc:Loc Flows_ColumnsHeader}" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Flows_ColumnsHint}"/>
                    <DataGrid x:Name="ColumnsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="280" Margin="0,6,0,0"
                              SelectionUnit="Cell" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColList}" Binding="{Binding ListTitle}" IsReadOnly="True" Width="170"/>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColSourceColumn}" Binding="{Binding SourceColumn}" IsReadOnly="True" Width="*"/>
                            <DataGridTemplateColumn Header="{loc:Loc Flows_ColTargetColumn}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Internal"
                                                  SelectedValue="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Margin="2,1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Forms_ColResult}" Binding="{Binding StatusText}" IsReadOnly="True" Width="190"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Step 4: forms and email ──────────────────────────────────── -->
            <ScrollViewer Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=3}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{loc:Loc Flows_FormsEmailHeader}" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Flows_Step4Hint}"/>

                    <TextBlock Text="{loc:Loc Flows_FormsHeader}" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <Border Style="{StaticResource InfoBanner}" Margin="0,6,0,0" Padding="12,8"
                            Visibility="{Binding NoForms, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{loc:Loc Flows_NoFormsFound}"/>
                    </Border>
                    <DataGrid x:Name="FormsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" MaxHeight="220" Margin="0,6,0,0"
                              Visibility="{Binding HasForms, Converter={StaticResource BoolToVis}}"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColSourceForm}" Binding="{Binding SourceId}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColNewForm}" Binding="{Binding NewId, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColFormNote}" Binding="{Binding Note}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Visibility="{Binding HasValues, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc Flows_ValuesHeader}" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,0"/>
                        <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Flows_ValuesHint}"/>
                        <DataGrid x:Name="ValuesGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" MaxHeight="240" Margin="0,6,0,0"
                                  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Flows_ColValueKind}" Binding="{Binding KindText}" IsReadOnly="True" Width="110"/>
                                <DataGridTextColumn Header="{loc:Loc Flows_ColValueSource}" Binding="{Binding Source}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc Flows_ColValueTarget}" Binding="{Binding Target, UpdateSourceTrigger=LostFocus}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <TextBlock Text="{loc:Loc Flows_EmailHeader}" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,0"/>
                    <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Flows_EmailHint}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{loc:Loc Flows_EmailDomain}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="DomainFromBox" Width="220" Style="{StaticResource WatermarkTextBox}" Tag="contoso.com"/>
                        <TextBlock Text="→" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBox x:Name="DomainToBox" Width="220" Style="{StaticResource WatermarkTextBox}" Tag="fabrikam.com"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Step 5: write ────────────────────────────────────────────── -->
            <ScrollViewer Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=4}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="0,8,12,0">
                    <TextBlock Text="{loc:Loc Flows_WriteHeader}" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource SubHeader}" Text="{loc:Loc Flows_Step5Hint}"/>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Flows_OutputFolder}" Style="{StaticResource CardHeader}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BaseTextBox}"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Ui_Browse}" Click="BrowseOutput_Click" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InfoBanner}" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding WriteSummaryText}"/>
                    </Border>
                    <Border Style="{StaticResource WarningBanner}" Margin="0,10,0,0"
                            Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding NotesText}"/>
                    </Border>
                    <Border Style="{StaticResource WarningBanner}" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Text="{loc:Loc Flows_ConnectionsNote}"/>
                    </Border>
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Flows_SaveMapping}" Click="SaveMapping_Click"
                            HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Step 6: report ───────────────────────────────────────────── -->
            <ScrollViewer Visibility="{Binding CurrentStep, Converter={StaticResource EqToVis}, ConverterParameter=5}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <Border Style="{StaticResource OutcomeBanner}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding ResultHeadline}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ResultSubline}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding PackagesWritten}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Flows_CardPackages}" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Replacements}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Flows_CardReplacements}" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding StillSourceCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Flows_CardStillSource}" Foreground="{DynamicResource WarningTextBrush}" HorizontalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding ReviewCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Flows_CardReview}" Foreground="{DynamicResource WarningTextBrush}" HorizontalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding DurationText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc Ui_Duration}" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <WrapPanel Margin="0,4,0,8">
                        <Button Style="{StaticResource PrimaryBtn}" Margin="0,0,8,6" Content="{loc:Loc Flows_OpenOutput}" Click="OpenOutput_Click"/>
                        <Button Style="{StaticResource SecondaryBtn}" Margin="0,0,8,6" Content="{loc:Loc Flows_OpenReport}" Click="OpenReport_Click"/>
                        <Button Style="{StaticResource SecondaryBtn}" Margin="0,0,8,6" Content="{loc:Loc Flows_SaveMapping}" Click="SaveMapping_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="PackagesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="200"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColPackage}" Binding="{Binding Package}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Loc Flows_ColFlows}" Binding="{Binding Flows}" Width="60"/>
                            <DataGridTextColumn Header="{loc:Loc Flows_CardReplacements}" Binding="{Binding Replacements}" Width="110"/>
                            <DataGridTextColumn Header="{loc:Loc Forms_ColResult}" Binding="{Binding StatusText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{loc:Loc Flows_NextStepsHeader}" Style="{StaticResource SectionHeader}" Margin="0,18,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Text="{loc:Loc Flows_NextSteps}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ══ Footer ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,12,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Forms_Back}" Click="Back_Click" Margin="0,0,8,0"
                            Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}"/>
                    <Button Style="{StaticResource PrimaryBtn}" Content="{Binding NextButtonText}" Click="Next_Click" Margin="0,0,8,0"
                            Visibility="{Binding ShowNext, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding CanNext}"/>
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Ui_Cancel}" Click="CancelRun_Click" Margin="0,0,8,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Flows_StartOver}" Click="StartOver_Click" Margin="0,0,8,0"
                            Visibility="{Binding ShowStartOver, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource SecondaryBtn}" Content="{loc:Loc Forms_Close}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
