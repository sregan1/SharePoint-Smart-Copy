<Window xmlns:loc="clr-namespace:SharePointSmartCopy.Localization" x:Class="SharePointSmartCopy.Dialogs.PrecheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc Ui_PrecheckTitle}"
        Width="900" Height="560" MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="20" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title + explanation -->
            <RowDefinition Height="*"/>      <!-- flagged items -->
            <RowDefinition Height="Auto"/>   <!-- what happens next -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Loc Ui_PrecheckTitle}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,6,0,12" FontSize="13"/>
        </StackPanel>

        <!-- Paths and reasons are shown as written; paths are always left-to-right, even in right-to-left languages. -->
        <DataGrid x:Name="IssueGrid" Grid.Row="1" FlowDirection="LeftToRight"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Ui_PrecheckColItem}" Binding="{Binding SourcePath, Mode=OneWay}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="4,3"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{loc:Loc Ui_PrecheckColProblem}" Binding="{Binding Reason, Mode=OneWay}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding" Value="4,3"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="{loc:Loc Ui_PrecheckNextSteps}"/>

        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Left" Content="{loc:Loc Ui_PrecheckSaveList}" Style="{StaticResource SecondaryBtn}"
                    Click="SaveList_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Cancel is the default and the Esc / close-button answer: a copy only goes ahead when the user says so. -->
                <Button Content="{loc:Loc Ui_PrecheckCancelCopy}" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0"
                        IsCancel="True" IsDefault="True" Click="CancelCopy_Click"/>
                <Button Content="{loc:Loc Ui_PrecheckCopyRest}" Style="{StaticResource PrimaryBtn}" Click="CopyRest_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
