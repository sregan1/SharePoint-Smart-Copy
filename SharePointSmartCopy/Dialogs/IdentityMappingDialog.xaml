<Window xmlns:loc="clr-namespace:SharePointSmartCopy.Localization" x:Class="SharePointSmartCopy.Dialogs.IdentityMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc Ui_IdentityMapping}"
        Width="840" Height="700" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FocusManager.FocusedElement="{Binding ElementName=MappingGrid}"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="20" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title + intro -->
            <RowDefinition Height="Auto"/>   <!-- "needed but not found" banner -->
            <RowDefinition Height="Auto"/>   <!-- domain swap -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- table -->
            <RowDefinition Height="Auto"/>   <!-- summary -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>   <!-- buttons -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Loc Ui_IdentityMapping}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,12" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="{loc:Loc Ui_IdentityMappingIntro}"/>
        </StackPanel>

        <!-- Shown only when the dialog was opened from a run's "unresolved users". -->
        <Border x:Name="PrefillBanner" Grid.Row="1" Style="{StaticResource WarningBanner}" Margin="0,0,0,12"
                Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" FontSize="12" Text="{loc:Loc Ui_IdentityPrefillBanner}"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc Ui_SourceEmailDomain}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="SourceDomainBox" FlowDirection="LeftToRight" Tag="contoso.com"
                         Style="{StaticResource WatermarkTextBox}" TextChanged="Input_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{loc:Loc Ui_TargetEmailDomain}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TargetDomainBox" FlowDirection="LeftToRight" Tag="fabrikam.com"
                         Style="{StaticResource WatermarkTextBox}" TextChanged="Input_Changed"/>
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <Button Content="{loc:Loc Ui_IdentityAddRow}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,6" Click="AddRow_Click"/>
            <Button x:Name="RemoveButton" Content="{loc:Loc Ui_IdentityRemoveRows}" Style="{StaticResource SecondaryBtn}"
                    Margin="0,0,8,6" Click="RemoveRows_Click"/>
            <Button Content="{loc:Loc Ui_IdentityFillFromDomain}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,6"
                    ToolTip="{loc:Loc Ui_IdentityFillFromDomainHint}" Click="FillFromDomain_Click"/>
            <Button x:Name="CheckButton" Content="{loc:Loc Ui_IdentityCheck}" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,6"
                    Click="Check_Click"/>
            <Button Content="{loc:Loc Ui_IdentityImportCsv}" Style="{StaticResource LinkBtn}" Margin="8,0,0,6" Click="ImportCsv_Click"/>
            <Button Content="{loc:Loc Ui_IdentityExportCsv}" Style="{StaticResource LinkBtn}" Margin="0,0,0,6" Click="ExportCsv_Click"/>
        </WrapPanel>

        <!-- Emails and group names are always left-to-right, even in right-to-left languages. -->
        <DataGrid x:Name="MappingGrid" Grid.Row="4" FlowDirection="LeftToRight"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="28"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- A row with a problem is tinted and says why when hovered. -->
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                            <Setter Property="ToolTip" Value="{Binding Error}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Ui_IdentityColSource}" Width="*"
                                    Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="{loc:Loc Ui_IdentityColTarget}" Width="*"
                                    Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="{loc:Loc Ui_IdentityColKind}" Width="70" IsReadOnly="True"
                                    Binding="{Binding Kind, Mode=OneWay}"/>
                <DataGridTextColumn Header="{loc:Loc Ui_IdentityColStatus}" Width="110" IsReadOnly="True"
                                    Binding="{Binding StatusText, Mode=OneWay}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFound}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNotFound}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="NeededForColumn" Header="{loc:Loc Ui_IdentityColNeededFor}" Width="150" IsReadOnly="True"
                                    Visibility="Collapsed" Binding="{Binding Note, Mode=OneWay}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Live feedback: how many mappings, which rows have problems, results of "Check in target". -->
        <TextBlock Grid.Row="5" x:Name="SummaryText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextTertiaryBrush}"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Ui_Cancel}" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="{loc:Loc Ui_Save}" Style="{StaticResource PrimaryBtn}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
