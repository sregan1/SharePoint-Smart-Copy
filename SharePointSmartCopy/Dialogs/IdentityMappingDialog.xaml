<Window xmlns:loc="clr-namespace:SharePointSmartCopy.Localization" x:Class="SharePointSmartCopy.Dialogs.IdentityMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:Loc Ui_IdentityMapping}"
        Width="600" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Margin="20" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Loc Ui_IdentityMapping}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,14" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="{loc:Loc Ui_IdentityMappingIntro}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Loc Ui_SourceEmailDomain}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="SourceDomainBox" Tag="contoso.com" Style="{StaticResource WatermarkTextBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{loc:Loc Ui_TargetEmailDomain}" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TargetDomainBox" Tag="fabrikam.com" Style="{StaticResource WatermarkTextBox}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{loc:Loc Ui_IdentityOverrides}" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Row="1" x:Name="OverridesBox" AcceptsReturn="True" AcceptsTab="False"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" Padding="6"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc Ui_Cancel}" Style="{StaticResource SecondaryBtn}" Margin="0,0,12,0" Click="Cancel_Click"/>
            <Button Content="{loc:Loc Ui_Save}" Style="{StaticResource PrimaryBtn}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
